{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DrinkApiDb;Trusted_Connection=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SeedData": {
    "Enabled": true
  },
  "Cors": { "AllowedOrigins": [ "http://127.0.0.1:5500", "http://localhost:5500" ] },
  "DefaultAdmin": {
    "Email": "admin@example.com",
    "Password": ""
  },
  "DefaultUser": {
    "Email": "user@example.com",
    "Password": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "DrinkApi",
    "Audience": "DrinkApiUsers",
    "ExpiresMinutes": 60
  },
  "AllowedHosts": "*"
}